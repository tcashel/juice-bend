import Base
import ../src/domain.bend as Domain

# Expected digests were independently generated by Python hashlib.sha256.
# Fixture byte i is (73*i+19) mod 256; the hash implementation is not an oracle.
def check(ok: Bool,label: String) -> IO(Unit):
  match ok:
    case True{}:
      IO.print("PASS " ++ label)
    case False{}:
      IO.die(Unit,1,"FAIL " ++ label)

def initial() -> Domain.HashContext:
  Domain.HashContext{Domain.hash_initial(),[],0,0}

def pattern_go(count: Nat,+index: U32,acc: List<&2,U32>) -> List<&2,U32>:
  match count:
    case 0n:
      List.reverse(&2,U32,acc)
    case 1n+rest:
      pattern_go(rest,U32.add(index,1),U32.mod((index*73+19 : U32),256) <> acc)

def pattern(count: Nat) -> List<&2,U32>:
  pattern_go(count,0,[])

def vector(+count: Nat,expected: String) -> IO(Unit):
  check(String.eq(Domain.digest(pattern(count)),expected),
    "independent SHA256 patterned bytes length " ++ Nat.show(count))

def split_digest(+bytes: List<&2,U32>,+at: Nat) -> String:
  Domain.hash_finish(Domain.hash_bytes(List.drop(&2,U32,bytes,at),
    Domain.hash_bytes(List.take(&2,U32,bytes,at),initial())))

def every_split(remaining: Nat,+at: Nat) -> IO(Unit):
  match remaining:
    case 0n:
      IO.pure(Unit,Unit{})
    case 1n+rest:
      do IO<Unit>:
        check(String.eq(split_digest(pattern(129n),at),
          "d672408e0571636ea21092304eb31ba8fc1fbffc5d5ea6531d62b072714599db"),
          "stream split preserves exact digest at byte " ++ Nat.show(at))
        every_split(rest,1n+at)

def chunked(fuel: Nat,bytes: List<&2,U32>,+size: Nat,context: Domain.HashContext) -> String:
  match fuel:
    case 0n:
      "chunk progress exhausted"
    case 1n+rest:
      match bytes:
        case []:
          Domain.hash_finish(context)
        case +head <> +tail:
          chunked(rest,List.drop(&2,U32,head <> tail,size),size,
            Domain.hash_bytes(List.take(&2,U32,head <> tail,size),context))

def large_chunks(+size: Nat) -> IO(Unit):
  check(String.eq(chunked(262145n,pattern(262144n),size,initial()),
    "1b688a83ba854905616a168d0dc22e62d6dc868aa585f4412657a602fa64d6d3"),
    "maximum captured fragment streamed in chunks of " ++ Nat.show(size))

def all_bytes(count: Nat,+byte: U32) -> List<&2,U32>:
  match count:
    case 0n:
      []
    case 1n+rest:
      byte <> all_bytes(rest,U32.add(byte,1))

def context_matches(context: Domain.HashContext,+count: U32) -> Bool:
  match context:
    case Domain.HashContext{state,pending,used,size}:
      +expected = U32.mod(count,64)
      U32.is_eq(used,expected) && U32.is_eq(size,count) &&
        Domain.bytes_equal(pending,List.reverse(&2,U32,
          List.drop(&2,U32,pattern(U32.to_nat(count)),
            U32.to_nat(U32.sub(count,expected)))))

def context_case(+count: U32) -> IO(Unit):
  check(context_matches(Domain.hash_bytes(pattern(U32.to_nat(count)),initial()),count),
    "HashContext exact pending bytes and length after " ++ U32.show(count))

def padding(+size: U32,used: U32,zeros: Nat,length: List<&2,U32>) -> IO(Unit):
  check(Domain.bytes_equal(Domain.hash_padding(size,used),
    128 <> List.append(&2,U32,List.replicate(U32,zeros,0),length)),
    "padding exact 64-bit bit length for byte count " ++ U32.show(size))

def main() -> IO(Unit):
  do IO<Unit>:
    vector(0n,"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    vector(1n,"ab897fbdedfa502b2d839b6a56100887dccdc507555c282e59589e06300a62e2")
    vector(55n,"0c43a30970ee9525a6603d5656803c325bded148fa65bbd363df54cb3ac3dee5")
    vector(56n,"f4dcdc09c846d1b3621701516b300055c1e7875e216ba019dd4423f5a420f2d0")
    vector(63n,"ba3bb62c4369fe74e7b94392d0f04ed284a7b5d7295bfa48fabdb25c01d85ab7")
    vector(64n,"cb6862268ca7c02e7b6af558f0e3d236ce9ec7ff41cc746b2848c04c582da94e")
    vector(65n,"b68af55df9ce8ee60870e45d10e36b2e8363c9896f6e62478dcb6f593a4d7133")
    vector(127n,"a8365b6e6ed1daf56c41bae89ab089c03b671240ae103070480a7f271bdbad57")
    vector(128n,"d399f065c9f21e2fd51e2aeadb7768eab7e6e45e5150f31227c9711934a4d1d3")
    vector(129n,"d672408e0571636ea21092304eb31ba8fc1fbffc5d5ea6531d62b072714599db")
    vector(256n,"8e5ed1e6474d39bf1594411085e7a50c15aabaa768e633ebf0960ce20e84e336")
    vector(262144n,"1b688a83ba854905616a168d0dc22e62d6dc868aa585f4412657a602fa64d6d3")
    check(String.eq(Domain.digest(all_bytes(256n,0)),
      "40aff2e9d2d8922e47afd4648e6967497158785fbd1da870e7110266bf944880"),
      "every byte value including NUL and invalid UTF8 is preserved")
    check(String.eq(Domain.digest([0,255,128,0,10,13,254]),
      "06613ac1cd22886f0b69ca3217b15d98435cd0b5b598261940964a4394295f6d"),
      "fixed binary NUL vector remains compatible")
    check(String.eq(Domain.digest(List.append(&2,U32,
      Domain.encode("42|7|8192|7|"),[0,255,128,0,10,13,254])),
      "e02b94f95d04fcdf72b60e44be3f93ca1b5197e572907afcf81d248abbfd779f"),
      "fixed retained-record identity preimage has its prior digest")
    every_split(130n,0n)
    large_chunks(1n)
    large_chunks(63n)
    large_chunks(64n)
    large_chunks(65n)
    context_case(0)
    context_case(1)
    context_case(63)
    context_case(64)
    context_case(65)
    context_case(127)
    context_case(128)
    context_case(129)
    padding(55,55,0n,[0,0,0,0,0,0,1,184])
    padding(56,56,63n,[0,0,0,0,0,0,1,192])
    padding(536870911,63,56n,[0,0,0,0,255,255,255,248])
    padding(536870912,0,55n,[0,0,0,1,0,0,0,0])
    padding(1073741824,0,55n,[0,0,0,2,0,0,0,0])
    padding(2147483648,0,55n,[0,0,0,4,0,0,0,0])
    padding(4294967295,63,56n,[0,0,0,7,255,255,255,248])
