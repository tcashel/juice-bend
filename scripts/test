#!/bin/sh
set -eu
umask 077
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
explicit=1
if [ "$#" -eq 0 ]; then
  explicit=0
  set -- tests/*.bend
fi
count=0
for entry do
  if [ ! -f "$entry" ]; then
    if [ "$explicit" -eq 1 ]; then
      printf 'Missing test entry point: %s\n' "$entry" >&2
      exit 1
    fi
    continue
  fi
  count=$((count + 1))
  name=$(basename "$entry" .bend)
  binary="$ROOT/build/tests/$name"
  ./scripts/build "$entry" "$binary"
  data=$(mktemp -d "${TMPDIR:-/tmp}/juice-bend-test-$name.XXXXXX")
  mkdir "$data/.build"
  printf 'Running %s in isolated directory %s\n' "$entry" "$data" >&2
  # All assertions and fixture semantics live in this Bend executable.
  (cd "$data" && "$binary")
done
if [ "$count" -eq 0 ]; then
  printf 'No test entry points found; no tests have passed.\n' >&2
  exit 1
fi
printf 'Completed %s Bend test executables.\n' "$count" >&2
