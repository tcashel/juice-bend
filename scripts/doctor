#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
failed=0
printf 'Juice Bend host: %s %s\n' "$(uname -s)" "$(uname -m)"
if [ "$(uname -s)" = Darwin ]; then
  sw_vers
fi
for tool in mise xcrun shasum; do
  if command -v "$tool" >/dev/null 2>&1; then
    printf '%s: ' "$tool"
    "$tool" --version | head -n 1
  else
    printf 'MISSING: %s (install explicitly; doctor makes no global changes)\n' "$tool"
    failed=1
  fi
done
if [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ]; then
  ./scripts/setup-llvm --check || failed=1
  printf 'Native SDK: '
  /usr/bin/xcrun --sdk macosx --show-sdk-path || failed=1
  printf 'Native deployment target: %s; pinned LLVM optimization: -O1\n' "${MACOSX_DEPLOYMENT_TARGET:-26.0}"
else
  printf 'UNAVAILABLE: native app compiler requires macOS arm64.\n'
fi
if [ -f .tools/bend/SOURCE_REVISION ]; then
  printf 'Bend source: %s\n' "$(cat .tools/bend/SOURCE_REVISION)"
  if shasum -a 256 -c toolchain/bend.sha256 >/dev/null; then
    printf 'Bend source integrity: verified against toolchain/bend.sha256\n'
  else
    printf 'FAILED: pinned Bend source integrity\n'
    failed=1
  fi
  ./scripts/bend version || failed=1
else
  printf 'MISSING: pinned Bend source; run ./scripts/setup\n'
  failed=1
fi
if [ -x /usr/bin/sqlite3 ]; then
  printf 'System SQLite diagnostic (the bridge probe checks the linked engine):\n'
  /usr/bin/sqlite3 :memory: 'SELECT sqlite_version(); SELECT sqlite_compileoption_used('"'"'ENABLE_FTS5'"'"');'
else
  printf 'UNVERIFIED: system SQLite diagnostic executable is unavailable\n'
fi
if [ -e .tools/lean-4.34.0 ] || [ -L .tools/lean-4.34.0 ]; then
  ./scripts/setup-lean --check || failed=1
elif command -v lean >/dev/null 2>&1; then
  lean --version
else
  printf 'UNAVAILABLE: Lean 4.34.0; the stronger proof kernel requires this exact version\n'
fi
printf 'Native UI/input/clipboard acceptance requires an observed ./scripts/smoke-ui run.\n'
exit "$failed"
