#!/bin/sh
set -eu
ASSET_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ROOT="$ASSET_ROOT"
while [ ! -f "$ROOT/mise.toml" ]; do
  [ "$ROOT" != / ] || { echo "font-pack: repository mise.toml not found" >&2; exit 1; }
  ROOT=$(dirname -- "$ROOT")
done
cd "$ROOT"
export BEND_NO_TELEMETRY=1
export MISE_STATE_DIR="$ROOT/.tools/mise-state"
export MISE_CACHE_DIR="$ROOT/.cache/mise"
export MISE_TRUSTED_CONFIG_PATHS="$ROOT"
exec mise exec -- bun "$ASSET_ROOT/scripts/font-pack.ts" "$@"
