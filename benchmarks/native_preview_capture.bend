def message(content: String) -> String:
  "{\"type\":\"user\",\"sessionId\":\"native-preview-synthetic\",\"cwd\":\"/synthetic/image-preview\",\"timestamp\":\"2026-10-21T12:00:00Z\",\"message\":{\"content\":" ++ content ++ "}}\n"

def inline(media: String,data: String) -> String:
  "{\"type\":\"image\",\"source\":{\"type\":\"base64\",\"media_type\":" ++ J.quote(media) ++ ",\"data\":" ++ J.quote(data) ++ "}}"

def fixture() -> String:
  message("[" ++ inline("image/png",image_data()) ++ "]") ++
    message("[{\"type\":\"text\",\"text\":\"retained-image-preview-search café 中文 🙂. This captured record survives source removal.\"}]") ++
    message("[" ++ inline("image/jpeg","/9j/") ++ "]") ++
    message("[{\"type\":\"image\",\"source\":{\"type\":\"url\",\"url\":\"https://example.invalid/not-fetched.png\"}}]")

def root_shape(+root: String) -> Bool:
  +prefix = {"/private/tmp/juice-bend-image-fixture-" : String}
  String.starts_with(root,prefix) && Origin.uuid(String.split(String.drop(root,String.length(prefix)),'-'))

def source(root: String) -> String: root ++ "/sources/preview.jsonl.zst"
def marker(root: String) -> String: root ++ "/.juice-bend-image-fixture-v1.json"

def manifest(+root: String) -> String:
  "{\"fixture\":\"juice-bend-image-fixture-v1\",\"synthetic\":true,\"root\":" ++ J.quote(root) ++
    ",\"data_dir\":" ++ J.quote(root ++ "/library") ++ ",\"source\":" ++ J.quote(source(root)) ++
    ",\"snapshot\":\"1\",\"source_removed\":true,\"provider\":\"claude\",\"encoding\":\"zstd-jsonl-v1\",\"records\":4,\"image_record\":0,\"image_reference\":0,\"image_path\":\"/message/content/0/source/data\",\"jpeg_record\":2,\"remote_record\":3,\"png_bytes\":6555,\"png_sha256\":\"2fadba069c92c7b9981c87e6d05b7251de6e6ec8c72afc571eaadad49578d64f\",\"width\":1024,\"height\":640,\"search\":\"retained-image-preview-search\"}"

def prepare(+root: String) -> IO(Unit):
  do IO<Unit>:
    Store.checked(root_shape(root),"Expected a new /private/tmp/juice-bend-image-fixture-UUID")
    canonical : String <- Paths.destination(root)
    Store.checked(String.eq(canonical,root),"Synthetic native image root must be canonical")
    Safe.directory(root)
    Safe.regular_path(root,True{})
    Safe.directory(root ++ "/sources")
    Safe.directory(root ++ "/library")
    Safe.absent(source(root))
    Archive.write(source(root),Archive.raw_frame(D.encode(fixture())))
    Safe.private_file(source(root),"600")
    +db : U32 <- Store.open(root ++ "/library/juice-bend.sqlite")
    snapshot : String <- Capture.import_file(db,"claude",source(root))
    Store.checked(String.eq(snapshot,"1"),"Expected exact initial image capture")
    Safe.exact_capture(db,"1",fixture())
    Safe.scalar(db,"SELECT count(*) FROM snapshots WHERE accepted=1 AND records=4",[],"1")
    Safe.scalar(db,"PRAGMA quick_check",[],"ok")
    IO.try(Unit,Sql.close(db))
    removed : String <- Safe.command("/bin/rm",["--",source(root)])
    Safe.absent(source(root))
    Safe.absent(marker(root))
    +description : String = manifest(root)
    Store.write_text(marker(root),"w",description ++ "\n")
    Safe.private_file(marker(root),"400")
    IO.print(description)

def arguments(args: List<String>) -> IO(Unit):
  match args:
    case _ <> root <> []: prepare(root)
    case _: IO.die(Unit,2,"Expected one fresh synthetic native image root")

def main() -> IO(Unit):
  do IO<Unit>:
    args : List<String> <- IO.args()
    arguments(args)
